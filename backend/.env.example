# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DB=spendora
# Optional hosted connection URLs; MYSQL_PUBLIC_URL is required outside Railway's private network.
# MYSQL_PUBLIC_URL=mysql://user:password@public-host:port/spendora
# MYSQL_URL=mysql://user:password@host:3306/spendora
# MYSQL_SSL=true

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
