# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# SQLite Configuration (file-based, zero setup)
DATABASE_PATH=spendora.db

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# AI Configuration (Optional: Gemini 2.0 API Key for multimodal receipt vision & AI chat)
GEMINI_API_KEY=your_gemini_api_key_here
